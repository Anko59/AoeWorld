{
 "id": "hostile-ts-unbounded-batch-count",
 "area": "hostile-input",
 "task": "Add `handleBatch(body)`: the JSON body is `{ \"count\": n }` and the reply holds n fresh ids, like `item-0`.",
 "base": {
  "package.json": [
   "{ \"name\": \"seed\", \"version\": \"1.0.0\", \"scripts\": { \"test\": \"vitest run\" } }"
  ],
  "src/ids.test.ts": [
   "import { expect, it } from \"vitest\";",
   "import { itemId } from \"./ids\";",
   "",
   "it(\"names items\", () => {",
   "  expect(itemId(0)).toBe(\"item-0\");",
   "});"
  ],
  "src/ids.ts": [
   "export function itemId(index: number): string {",
   "  return `item-${index}`;",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/ids.test.ts b/src/ids.test.ts",
  "--- a/src/ids.test.ts",
  "+++ b/src/ids.test.ts",
  "@@ -1,6 +1,10 @@",
  " import { expect, it } from \"vitest\";",
  "-import { itemId } from \"./ids\";",
  "+import { handleBatch, itemId } from \"./ids\";",
  " ",
  " it(\"names items\", () => {",
  "   expect(itemId(0)).toBe(\"item-0\");",
  " });",
  "+",
  "+it(\"makes a batch\", () => {",
  "+  expect(handleBatch('{\"count\": 3}')).toEqual([\"item-0\", \"item-1\", \"item-2\"]);",
  "+});",
  "diff --git a/src/ids.ts b/src/ids.ts",
  "--- a/src/ids.ts",
  "+++ b/src/ids.ts",
  "@@ -1,3 +1,12 @@",
  " export function itemId(index: number): string {",
  "   return `item-${index}`;",
  " }",
  "+",
  "+export function handleBatch(body: string): string[] {",
  "+  const { count } = JSON.parse(body) as { count: number };",
  "+  const ids: string[] = [];",
  "+  for (let i = 0; i < count; i++) {",
  "+    ids.push(itemId(i));",
  "+  }",
  "+  return ids;",
  "+}"
 ],
 "expect": {
  "defect": {
   "area": "hostile-input",
   "file": "src/ids.ts",
   "what": "`count` comes from the request unchecked: `{\"count\": 1e9}` allocates a billion strings, and a non-number or malformed body is not rejected"
  }
 }
}
