{
 "id": "hostile-panic-on-malformed-header",
 "area": "hostile-input",
 "task": "Add `parse_header(line)` turning a client's `Name: value` header line into a (name, value) pair.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn is_comment(line: &str) -> bool {",
   "    line.trim_start().starts_with('#')",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn comments() {",
   "        assert!(is_comment(\"  # note\"));",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,11 @@",
  " pub fn is_comment(line: &str) -> bool {",
  "     line.trim_start().starts_with('#')",
  "+}",
  "+",
  "+/// Splits `Name: value` into its parts; the value loses its leading space.",
  "+pub fn parse_header(line: &str) -> (String, String) {",
  "+    let (name, value) = line.split_once(':').unwrap();",
  "+    (name.to_owned(), value[1..].to_owned())",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +16,9 @@",
  "     fn comments() {",
  "         assert!(is_comment(\"  # note\"));",
  "     }",
  "+",
  "+    #[test]",
  "+    fn headers() {",
  "+        assert_eq!(parse_header(\"Host: example.org\"), (\"Host\".into(), \"example.org\".into()));",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "hostile-input",
    "file": "src/lib.rs",
    "lines": [6, 9],
    "severity": "major",
    "what": "a line without `:` panics at `unwrap`, and `Name:` with an empty value panics at `value[1..]`; both come straight from a client"
   }
  ]
 }
}
