  "+pub fn shorten(text: &str, max: usize) -> String {",
  "+    if text.chars().count() <= max {",
  "+        return text.to_owned();",
  "+    }",
  "+    text.chars().take(max).collect()",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +19,10 @@",
