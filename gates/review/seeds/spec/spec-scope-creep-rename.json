{
 "id": "spec-scope-creep-rename",
 "area": "spec",
 "task": "Rename `get_user` to `find_user`; nothing else changes.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "use std::collections::HashMap;",
   "",
   "pub struct Users {",
   "    names: HashMap<u32, String>,",
   "}",
   "",
   "impl Users {",
   "    pub fn new() -> Self {",
   "        Self { names: HashMap::new() }",
   "    }",
   "",
   "    pub fn add(&mut self, id: u32, name: &str) {",
   "        self.names.insert(id, name.to_owned());",
   "    }",
   "",
   "    pub fn get_user(&self, id: u32) -> Option<&String> {",
   "        self.names.get(&id)",
   "    }",
   "",
   "    /// Kept for the old admin export.",
   "    pub fn legacy_export(&self) -> Vec<String> {",
   "        let mut rows: Vec<String> = self.names.iter().map(|(i, n)| format!(\"{i},{n}\")).collect();",
   "        rows.sort();",
   "        rows",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn looks_users_up() {",
   "        let mut users = Users::new();",
   "        users.add(1, \"ada\");",
   "        assert_eq!(users.get_user(1).map(String::as_str), Some(\"ada\"));",
   "        assert_eq!(users.get_user(2), None);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -2,26 +2,25 @@",
  " ",
  " pub struct Users {",
  "     names: HashMap<u32, String>,",
  "+    lookups: std::cell::Cell<u64>,",
  " }",
  " ",
  " impl Users {",
  "     pub fn new() -> Self {",
  "-        Self { names: HashMap::new() }",
  "+        Self { names: HashMap::new(), lookups: std::cell::Cell::new(0) }",
  "     }",
  " ",
  "     pub fn add(&mut self, id: u32, name: &str) {",
  "         self.names.insert(id, name.to_owned());",
  "     }",
  " ",
  "-    pub fn get_user(&self, id: u32) -> Option<&String> {",
  "+    pub fn find_user(&self, id: u32) -> Option<&String> {",
  "+        self.lookups.set(self.lookups.get() + 1);",
  "         self.names.get(&id)",
  "     }",
  " ",
  "-    /// Kept for the old admin export.",
  "-    pub fn legacy_export(&self) -> Vec<String> {",
  "-        let mut rows: Vec<String> = self.names.iter().map(|(i, n)| format!(\"{i},{n}\")).collect();",
  "-        rows.sort();",
  "-        rows",
  "+    pub fn lookup_count(&self) -> u64 {",
  "+        self.lookups.get()",
  "     }",
  " }",
  " ",
  "@@ -33,7 +32,7 @@",
  "     fn looks_users_up() {",
  "         let mut users = Users::new();",
  "         users.add(1, \"ada\");",
  "-        assert_eq!(users.get_user(1).map(String::as_str), Some(\"ada\"));",
  "-        assert_eq!(users.get_user(2), None);",
  "+        assert_eq!(users.find_user(1).map(String::as_str), Some(\"ada\"));",
  "+        assert_eq!(users.find_user(2), None);",
  "     }",
  " }"
 ],
 "expect": {
  "defect": {
   "area": "spec",
   "file": "src/lib.rs",
   "what": "beyond the rename it deletes the public `legacy_export` and adds lookup counting that nobody asked for"
  }
 }
}
