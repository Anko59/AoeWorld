{
 "id": "correctness-byte-sum-overflow",
 "area": "correctness",
 "task": "Add `checksum(bytes)` returning the sum of all bytes, valid for any input length.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn is_empty(bytes: &[u8]) -> bool {",
   "    bytes.is_empty()",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn empty() {",
   "        assert!(is_empty(&[]));",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,10 @@",
  " pub fn is_empty(bytes: &[u8]) -> bool {",
  "     bytes.is_empty()",
  "+}",
  "+",
  "+/// The sum of all bytes; any length is valid.",
  "+pub fn checksum(bytes: &[u8]) -> u32 {",
  "+    bytes.iter().fold(0u8, |sum, b| sum.wrapping_add(*b)) as u32",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +15,10 @@",
  "     fn empty() {",
  "         assert!(is_empty(&[]));",
  "     }",
  "+",
  "+    #[test]",
  "+    fn sums_small_inputs() {",
  "+        assert_eq!(checksum(&[1, 2, 3]), 6);",
  "+        assert_eq!(checksum(&[]), 0);",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/lib.rs",
    "lines": [6, 8],
    "severity": "major",
    "what": "the sum is accumulated in a wrapping u8, so inputs summing past 255 give wrong results"
   }
  ]
 }
}
