{
 "id": "correctness-window-sums-off-by-one",
 "area": "correctness",
 "task": "Add `window_sums(values, k)` returning the sum of every run of k consecutive values.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn total(values: &[i64]) -> i64 {",
   "    values.iter().sum()",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn totals() {",
   "        assert_eq!(total(&[1, 2, 3]), 6);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,13 @@",
  " pub fn total(values: &[i64]) -> i64 {",
  "     values.iter().sum()",
  "+}",
  "+",
  "+/// The sum of every run of `k` consecutive values (`k` must be at least 1).",
  "+pub fn window_sums(values: &[i64], k: usize) -> Vec<i64> {",
  "+    if k == 0 || values.len() < k {",
  "+        return Vec::new();",
  "+    }",
  "+    (0..values.len() - k).map(|i| total(&values[i..i + k])).collect()",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +18,10 @@",
  "     fn totals() {",
  "         assert_eq!(total(&[1, 2, 3]), 6);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn sums_windows() {",
  "+        assert_eq!(window_sums(&[1, 2, 3, 4, 5], 3)[0], 6);",
  "+        assert!(window_sums(&[1, 2], 3).is_empty());",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/lib.rs",
    "lines": [10, 10],
    "severity": "major",
    "what": "`0..values.len() - k` misses the last window; it must be `..=`"
   }
  ]
 }
}
