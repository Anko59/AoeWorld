{
 "id": "correctness-ts-page-count-floor",
 "area": "correctness",
 "task": "Add `pageCount(total, pageSize)`: how many pages are needed to show `total` rows.",
 "base": {
  "package.json": [
   "{ \"name\": \"seed\", \"version\": \"1.0.0\", \"scripts\": { \"test\": \"vitest run\" } }"
  ],
  "src/paging.test.ts": [
   "import { expect, it } from \"vitest\";",
   "import { pageOffset } from \"./paging\";",
   "",
   "it(\"offsets pages from one\", () => {",
   "  expect(pageOffset(1, 20)).toBe(0);",
   "  expect(pageOffset(3, 20)).toBe(40);",
   "});"
  ],
  "src/paging.ts": [
   "export function pageOffset(page: number, pageSize: number): number {",
   "  return (page - 1) * pageSize;",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/paging.test.ts b/src/paging.test.ts",
  "--- a/src/paging.test.ts",
  "+++ b/src/paging.test.ts",
  "@@ -1,7 +1,12 @@",
  " import { expect, it } from \"vitest\";",
  "-import { pageOffset } from \"./paging\";",
  "+import { pageCount, pageOffset } from \"./paging\";",
  " ",
  " it(\"offsets pages from one\", () => {",
  "   expect(pageOffset(1, 20)).toBe(0);",
  "   expect(pageOffset(3, 20)).toBe(40);",
  " });",
  "+",
  "+it(\"counts pages\", () => {",
  "+  expect(pageCount(100, 20)).toBe(5);",
  "+  expect(pageCount(0, 20)).toBe(0);",
  "+});",
  "diff --git a/src/paging.ts b/src/paging.ts",
  "--- a/src/paging.ts",
  "+++ b/src/paging.ts",
  "@@ -1,3 +1,7 @@",
  " export function pageOffset(page: number, pageSize: number): number {",
  "   return (page - 1) * pageSize;",
  " }",
  "+",
  "+export function pageCount(total: number, pageSize: number): number {",
  "+  return Math.floor(total / pageSize);",
  "+}"
 ],
