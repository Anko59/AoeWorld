{
 "id": "correctness-discount-rounding-order",
 "area": "correctness",
 "task": "Add `apply_discount(cents, percent)`: the price after the percent discount, rounded down to a whole cent.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn add_tax(cents: u64, percent: u64) -> u64 {",
   "    cents + cents * percent / 100",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn taxes() {",
   "        assert_eq!(add_tax(1000, 20), 1200);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,10 @@",
  " pub fn add_tax(cents: u64, percent: u64) -> u64 {",
  "     cents + cents * percent / 100",
  "+}",
  "+",
  "+/// The price after `percent` off (0..=100), rounded down to a whole cent.",
  "+pub fn apply_discount(cents: u64, percent: u64) -> u64 {",
  "+    cents / 100 * (100 - percent)",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +15,10 @@",
  "     fn taxes() {",
  "         assert_eq!(add_tax(1000, 20), 1200);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn discounts() {",
  "+        assert_eq!(apply_discount(1000, 25), 750);",
  "+        assert_eq!(apply_discount(200, 50), 100);",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/lib.rs",
    "lines": [6, 8],
    "severity": "major",
    "what": "dividing by 100 first truncates: apply_discount(199, 10) gives 90 instead of 179"
   }
  ]
 }
}
