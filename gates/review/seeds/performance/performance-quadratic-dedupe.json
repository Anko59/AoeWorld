   "pub fn count_alive(alive: &[bool]) -> usize {",
   "    alive.iter().filter(|a| **a).count()",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn counts() {",
   "        assert_eq!(count_alive(&[true, false, true]), 2);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,16 @@",
  " pub fn count_alive(alive: &[bool]) -> usize {",
  "     alive.iter().filter(|a| **a).count()",
  "+}",
  "+",
  "+/// Repeated ids removed, first occurrence kept, order preserved.",
  "+pub fn dedupe(ids: &[u32]) -> Vec<u32> {",
  "+    let mut out: Vec<u32> = Vec::new();",
  "+    for id in ids {",
  "+        if !out.contains(id) {",
  "+            out.push(*id);",
  "+        }",
  "+    }",
  "+    out",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +21,9 @@",
  "     fn counts() {",
  "         assert_eq!(count_alive(&[true, false, true]), 2);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn dedupes_in_order() {",
  "+        assert_eq!(dedupe(&[3, 1, 3, 2, 1]), vec![3, 1, 2]);",
  "+    }",
  " }"
 ],
