{
 "id": "performance-string-rebuild",
 "area": "performance",
 "task": "Add `render_log(lines)` joining log lines with newlines for the log panel; it redraws every frame with up to 100,000 lines.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn line_count(text: &str) -> usize {",
   "    text.lines().count()",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn counts_lines() {",
   "        assert_eq!(line_count(\"a\\nb\\n\"), 2);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,17 @@",
  " pub fn line_count(text: &str) -> usize {",
  "     text.lines().count()",
  "+}",
  "+",
  "+/// The lines joined by newlines, with no trailing newline.",
  "+pub fn render_log(lines: &[String]) -> String {",
  "+    let mut text = String::new();",
  "+    for (i, line) in lines.iter().enumerate() {",
  "+        if i > 0 {",
  "+            text = format!(\"{text}\\n\");",
  "+        }",
  "+        text = format!(\"{text}{line}\");",
  "+    }",
  "+    text",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -10,4 +22,10 @@",
  "     fn counts_lines() {",
  "         assert_eq!(line_count(\"a\\nb\\n\"), 2);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn joins_lines() {",
  "+        assert_eq!(render_log(&[\"a\".into(), \"b\".into()]), \"a\\nb\");",
  "+        assert_eq!(render_log(&[]), \"\");",
  "+    }",
  " }"
 ],
 "expect": {
  "defect": {
   "area": "performance",
   "file": "src/lib.rs",
   "what": "`format!(\"{text}…\")` copies the whole text for every line: 100,000 lines are quadratic; `join` or push_str is linear"
  }
 }
}
