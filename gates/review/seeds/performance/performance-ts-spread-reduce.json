 "task": "Add `groupBy(rows, key)` for the table view; it runs on every render with up to 100,000 rows.",
 "base": {
  "package.json": [
   "{ \"name\": \"seed\", \"version\": \"1.0.0\", \"scripts\": { \"test\": \"vitest run\" } }"
  ],
  "src/rows.test.ts": [
   "import { expect, it } from \"vitest\";",
   "import { totalScore } from \"./rows\";",
   "",
   "it(\"totals scores\", () => {",
   "  expect(totalScore([{ team: \"a\", score: 2 }, { team: \"b\", score: 3 }])).toBe(5);",
   "});"
  ],
  "src/rows.ts": [
   "export interface Row {",
   "  team: string;",
   "  score: number;",
