{
 "id": "clean-rust-error-enum",
 "area": "clean",
 "task": "Replace the `String` error of `parse_level` with a `LevelError` enum; callers' behaviour is unchanged.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn parse_level(text: &str) -> Result<u8, String> {",
   "    let level: u8 = text.trim().parse().map_err(|_| format!(\"not a number: {text}\"))?;",
   "    if level == 0 || level > 20 {",
   "        return Err(format!(\"level out of range: {level}\"));",
   "    }",
   "    Ok(level)",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn parses_levels() {",
   "        assert_eq!(parse_level(\" 7 \"), Ok(7));",
   "        assert!(parse_level(\"x\").is_err());",
   "        assert!(parse_level(\"0\").is_err());",
   "        assert!(parse_level(\"21\").is_err());",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,7 +1,16 @@",
  "-pub fn parse_level(text: &str) -> Result<u8, String> {",
  "-    let level: u8 = text.trim().parse().map_err(|_| format!(\"not a number: {text}\"))?;",
  "+#[derive(Debug, PartialEq, Eq)]",
  "+pub enum LevelError {",
  "+    NotANumber(String),",
  "+    OutOfRange(u8),",
  "+}",
  "+",
  "+pub fn parse_level(text: &str) -> Result<u8, LevelError> {",
  "+    let level: u8 = text",
  "+        .trim()",
  "+        .parse()",
  "+        .map_err(|_| LevelError::NotANumber(text.to_owned()))?;",
  "     if level == 0 || level > 20 {",
  "-        return Err(format!(\"level out of range: {level}\"));",
  "+        return Err(LevelError::OutOfRange(level));",
  "     }",
  "     Ok(level)",
  " }",
  "@@ -13,8 +22,8 @@",
  "     #[test]",
  "     fn parses_levels() {",
  "         assert_eq!(parse_level(\" 7 \"), Ok(7));",
  "-        assert!(parse_level(\"x\").is_err());",
  "-        assert!(parse_level(\"0\").is_err());",
  "-        assert!(parse_level(\"21\").is_err());",
  "+        assert_eq!(parse_level(\"x\"), Err(LevelError::NotANumber(\"x\".into())));",
  "+        assert_eq!(parse_level(\"0\"), Err(LevelError::OutOfRange(0)));",
  "+        assert_eq!(parse_level(\"21\"), Err(LevelError::OutOfRange(21)));",
  "     }",
  " }"
 ],
 "expect": {
  "clean": true
 }
}
