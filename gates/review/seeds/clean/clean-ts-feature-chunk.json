{
 "id": "clean-ts-feature-chunk",
 "area": "clean",
 "task": "Add `chunk(items, size)` splitting an array into arrays of at most `size`, throwing on size < 1, with tests.",
 "base": {
  "package.json": [
   "{ \"name\": \"seed\", \"version\": \"1.0.0\", \"scripts\": { \"test\": \"vitest run\" } }"
  ],
  "src/array.test.ts": [
   "import { expect, it } from \"vitest\";",
   "import { first } from \"./array\";",
   "",
   "it(\"returns the first item\", () => {",
   "  expect(first([3, 4])).toBe(3);",
   "  expect(first([])).toBeUndefined();",
   "});"
  ],
  "src/array.ts": [
   "export function first<T>(items: T[]): T | undefined {",
   "  return items[0];",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/array.test.ts b/src/array.test.ts",
  "--- a/src/array.test.ts",
  "+++ b/src/array.test.ts",
  "@@ -1,7 +1,17 @@",
  " import { expect, it } from \"vitest\";",
  "-import { first } from \"./array\";",
  "+import { chunk, first } from \"./array\";",
  " ",
  " it(\"returns the first item\", () => {",
  "   expect(first([3, 4])).toBe(3);",
  "   expect(first([])).toBeUndefined();",
  " });",
  "+",
  "+it(\"chunks with a short last chunk\", () => {",
  "+  expect(chunk([1, 2, 3, 4, 5], 2)).toEqual([[1, 2], [3, 4], [5]]);",
  "+  expect(chunk([], 3)).toEqual([]);",
  "+});",
  "+",
  "+it(\"rejects sizes below one\", () => {",
  "+  expect(() => chunk([1], 0)).toThrow(RangeError);",
  "+  expect(() => chunk([1], 1.5)).toThrow(RangeError);",
  "+});",
  "diff --git a/src/array.ts b/src/array.ts",
  "--- a/src/array.ts",
  "+++ b/src/array.ts",
  "@@ -1,3 +1,14 @@",
  " export function first<T>(items: T[]): T | undefined {",
  "   return items[0];",
  " }",
  "+",
  "+export function chunk<T>(items: T[], size: number): T[][] {",
  "+  if (!Number.isInteger(size) || size < 1) {",
  "+    throw new RangeError(\"size must be a positive integer\");",
  "+  }",
  "+  const chunks: T[][] = [];",
  "+  for (let i = 0; i < items.length; i += size) {",
  "+    chunks.push(items.slice(i, i + size));",
  "+  }",
  "+  return chunks;",
  "+}"
 ],
 "expect": {
  "clean": true
 }
}
