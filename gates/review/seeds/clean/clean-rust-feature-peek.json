{
 "id": "clean-rust-feature-peek",
 "area": "clean",
 "task": "Add `Stack::peek`, returning the top item without removing it, with tests.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "#[derive(Default)]",
   "pub struct Stack<T> {",
   "    items: Vec<T>,",
   "}",
   "",
   "impl<T> Stack<T> {",
   "    pub fn new() -> Self {",
   "        Self { items: Vec::new() }",
   "    }",
   "",
   "    pub fn push(&mut self, item: T) {",
   "        self.items.push(item);",
   "    }",
   "",
   "    pub fn pop(&mut self) -> Option<T> {",
   "        self.items.pop()",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn last_in_first_out() {",
   "        let mut stack = Stack::new();",
   "        stack.push(1);",
   "        stack.push(2);",
   "        assert_eq!(stack.pop(), Some(2));",
   "        assert_eq!(stack.pop(), Some(1));",
   "        assert_eq!(stack.pop(), None);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -15,6 +15,10 @@",
  "     pub fn pop(&mut self) -> Option<T> {",
  "         self.items.pop()",
  "     }",
  "+",
  "+    pub fn peek(&self) -> Option<&T> {",
  "+        self.items.last()",
  "+    }",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -30,4 +34,13 @@",
  "         assert_eq!(stack.pop(), Some(1));",
  "         assert_eq!(stack.pop(), None);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn peek_does_not_remove() {",
  "+        let mut stack = Stack::new();",
  "+        assert_eq!(stack.peek(), None);",
  "+        stack.push(\"a\");",
  "+        assert_eq!(stack.peek(), Some(&\"a\"));",
  "+        assert_eq!(stack.pop(), Some(\"a\"));",
  "+    }",
  " }"
 ],
 "expect": {
  "clean": true
 }
}
