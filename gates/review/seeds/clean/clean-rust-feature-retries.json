{
 "id": "clean-rust-feature-retries",
 "area": "clean",
 "task": "Add a `with_retries` builder method to `Client`, default 3, with a test.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub struct Client {",
   "    pub timeout_ms: u64,",
   "    pub retries: u32,",
   "}",
   "",
   "impl Client {",
   "    pub fn new() -> Self {",
   "        Self { timeout_ms: 1000, retries: 3 }",
   "    }",
   "",
   "    pub fn with_timeout(mut self, timeout_ms: u64) -> Self {",
   "        self.timeout_ms = timeout_ms;",
   "        self",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn defaults_and_timeout() {",
   "        let client = Client::new().with_timeout(250);",
   "        assert_eq!((client.timeout_ms, client.retries), (250, 3));",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -12,6 +12,11 @@",
  "         self.timeout_ms = timeout_ms;",
  "         self",
  "     }",
  "+",
  "+    pub fn with_retries(mut self, retries: u32) -> Self {",
  "+        self.retries = retries;",
  "+        self",
  "+    }",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -23,4 +28,10 @@",
  "         let client = Client::new().with_timeout(250);",
  "         assert_eq!((client.timeout_ms, client.retries), (250, 3));",
  "     }",
  "+",
  "+    #[test]",
  "+    fn retries_can_be_set() {",
  "+        assert_eq!(Client::new().with_retries(0).retries, 0);",
  "+        assert_eq!(Client::new().with_retries(7).retries, 7);",
  "+    }",
  " }"
 ],
 "expect": {
  "clean": true
 }
}
