{
 "id": "clean-ts-feature-unique",
 "area": "clean",
 "task": "Add `unique(items)` keeping the first occurrence of each item in order, with tests.",
 "base": {
  "package.json": [
   "{ \"name\": \"seed\", \"version\": \"1.0.0\", \"scripts\": { \"test\": \"vitest run\" } }"
  ],
  "src/list.test.ts": [
   "import { expect, it } from \"vitest\";",
   "import { last } from \"./list\";",
   "",
   "it(\"returns the last item\", () => {",
   "  expect(last([1, 2])).toBe(2);",
   "  expect(last([])).toBeUndefined();",
   "});"
  ],
  "src/list.ts": [
   "export function last<T>(items: T[]): T | undefined {",
   "  return items[items.length - 1];",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/list.test.ts b/src/list.test.ts",
  "--- a/src/list.test.ts",
  "+++ b/src/list.test.ts",
  "@@ -1,7 +1,12 @@",
  " import { expect, it } from \"vitest\";",
  "-import { last } from \"./list\";",
  "+import { last, unique } from \"./list\";",
  " ",
  " it(\"returns the last item\", () => {",
  "   expect(last([1, 2])).toBe(2);",
  "   expect(last([])).toBeUndefined();",
  " });",
  "+",
  "+it(\"keeps the first occurrence in order\", () => {",
  "+  expect(unique([3, 1, 3, 2, 1])).toEqual([3, 1, 2]);",
  "+  expect(unique([])).toEqual([]);",
  "+});",
  "diff --git a/src/list.ts b/src/list.ts",
  "--- a/src/list.ts",
  "+++ b/src/list.ts",
  "@@ -1,3 +1,7 @@",
  " export function last<T>(items: T[]): T | undefined {",
  "   return items[items.length - 1];",
  " }",
  "+",
  "+export function unique<T>(items: T[]): T[] {",
  "+  return [...new Set(items)];",
  "+}"
 ],
 "expect": {
  "clean": true
 }
