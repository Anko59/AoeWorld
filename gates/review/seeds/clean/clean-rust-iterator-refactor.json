{
 "id": "clean-rust-iterator-refactor",
 "area": "clean",
 "task": "Replace the manual loop in `mean` with iterator adapters; same results.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn mean(values: &[f64]) -> Option<f64> {",
   "    if values.is_empty() {",
   "        return None;",
   "    }",
   "    let mut sum = 0.0;",
   "    for v in values {",
   "        sum += v;",
   "    }",
   "    Some(sum / values.len() as f64)",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn mean_of_values() {",
   "        assert_eq!(mean(&[]), None);",
   "        assert_eq!(mean(&[2.0, 4.0, 6.0]), Some(4.0));",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -2,11 +2,7 @@",
  "     if values.is_empty() {",
  "         return None;",
  "     }",
  "-    let mut sum = 0.0;",
  "-    for v in values {",
  "-        sum += v;",
  "-    }",
  "-    Some(sum / values.len() as f64)",
  "+    Some(values.iter().sum::<f64>() / values.len() as f64)",
  " }",
  " ",
  " #[cfg(test)]"
 ],
 "expect": {
  "clean": true
 }
}
