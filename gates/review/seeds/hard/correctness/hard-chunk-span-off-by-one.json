{
 "id": "hard-chunk-span-off-by-one",
 "area": "correctness",
 "task": "Add `grid::tile_count(from, to)`: the number of tiles of chunks `from..to` (half-open, like `Row::prefix`), and `Row::chunk_span(from, to)`: those tiles as a slice, with tests.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub mod grid;",
   "pub mod row;"
  ],
  "src/grid.rs": [
   "/// Tiles along one edge of a chunk.",
   "pub const TILES_PER_CHUNK: usize = 4;",
   "",
   "/// The first tile of `chunk` (chunks and tiles are 0-based).",
   "pub fn first_tile(chunk: usize) -> usize {",
   "    chunk * TILES_PER_CHUNK",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn chunk_starts() {",
   "        assert_eq!(first_tile(0), 0);",
   "        assert_eq!(first_tile(2), 8);",
   "    }",
   "}"
  ],
  "src/row.rs": [
   "use crate::grid::first_tile;",
   "",
   "/// One row of the map: a flat strip of ground heights.",
   "pub struct Row {",
   "    tiles: Vec<u8>,",
   "}",
   "",
   "impl Row {",
   "    pub fn new(tiles: &[u8]) -> Self {",
   "        Row { tiles: tiles.to_vec() }",
   "    }",
   "",
   "    pub fn len(&self) -> usize {",
   "        self.tiles.len()",
   "    }",
   "",
   "    /// The tiles of chunks `0..to` (half-open: chunk `to` is not included).",
   "    pub fn prefix(&self, to: usize) -> &[u8] {",
   "        &self.tiles[..first_tile(to)]",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn prefix_stops_before_chunk_to() {",
   "        let row = Row::new(&[3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8]);",
   "        assert_eq!(row.prefix(2).len(), 8);",
   "        assert_eq!(row.len(), 12);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/grid.rs b/src/grid.rs",
  "--- a/src/grid.rs",
  "+++ b/src/grid.rs",
  "@@ -4,6 +4,11 @@",
  " /// The first tile of `chunk` (chunks and tiles are 0-based).",
  " pub fn first_tile(chunk: usize) -> usize {",
  "     chunk * TILES_PER_CHUNK",
  "+}",
  "+",
  "+/// The number of tiles covered by chunks `from..to` (half-open).",
  "+pub fn tile_count(from: usize, to: usize) -> usize {",
  "+    (to - from) * TILES_PER_CHUNK + 1",
  " }",
  " ",
  " #[cfg(test)]",
  "diff --git a/src/row.rs b/src/row.rs",
  "--- a/src/row.rs",
  "+++ b/src/row.rs",
  "@@ -1,4 +1,4 @@",
  "-use crate::grid::first_tile;",
  "+use crate::grid::{first_tile, tile_count};",
  " ",
  " /// One row of the map: a flat strip of ground heights.",
  " pub struct Row {",
  "@@ -18,6 +18,13 @@",
  "     pub fn prefix(&self, to: usize) -> &[u8] {",
  "         &self.tiles[..first_tile(to)]",
  "     }",
  "+",
  "+    /// The tiles of chunks `from..to` (half-open: chunk `to` is not",
  "+    /// included).",
  "+    pub fn chunk_span(&self, from: usize, to: usize) -> &[u8] {",
  "+        let start = first_tile(from);",
  "+        &self.tiles[start..start + tile_count(from, to)]",
  "+    }",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -30,4 +37,12 @@",
  "         assert_eq!(row.prefix(2).len(), 8);",
  "         assert_eq!(row.len(), 12);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn spans_chunks() {",
  "+        let row = Row::new(&[9, 9, 9, 9, 7, 7, 7, 7, 1, 2, 3, 4, 5]);",
  "+        assert!(row.chunk_span(1, 2).starts_with(&[7, 7, 7, 7]));",
  "+        assert!(row.chunk_span(0, 3).starts_with(&[9, 9, 9, 9]));",
  "+        assert_eq!(row.len(), 13);",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/grid.rs",
    "lines": [10, 11],
    "severity": "major",
    "what": "`tile_count` adds one to a half-open tile count, so `Row::chunk_span` (src/row.rs) slices one tile past every chunk boundary: `chunk_span(2, 3)` on a 12-tile row panics at index 13, and every span silently swallows the first tile of the next chunk"
   }
  ]
 }
}
