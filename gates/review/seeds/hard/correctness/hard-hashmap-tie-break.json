{
 "id": "hard-hashmap-tie-break",
 "area": "correctness",
 "task": "Store the scores in a `HashMap` (contestants join and leave constantly); the winner rule, the id order of `ids()` and the every-run determinism stay exactly as documented.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "use std::collections::BTreeMap;",
   "",
   "/// The round's scoreboard. The referee walks it after every round, and the",
   "/// same scores must crown the same winner on every run and every machine.",
   "pub struct Board {",
   "    scores: BTreeMap<u32, u32>,",
   "}",
   "",
   "impl Board {",
   "    pub fn new() -> Self {",
   "        Board {",
   "            scores: BTreeMap::new(),",
   "        }",
   "    }",
   "",
   "    pub fn add(&mut self, id: u32, score: u32) {",
   "        self.scores.insert(id, score);",
   "    }",
   "",
   "    pub fn len(&self) -> usize {",
   "        self.scores.len()",
   "    }",
   "",
   "    /// The contestant ids in id order.",
   "    pub fn ids(&self) -> Vec<u32> {",
   "        self.scores.keys().copied().collect()",
   "    }",
   "",
   "    /// The round's winner: the highest score; ties go to the lowest id.",
   "    pub fn winner(&self) -> Option<u32> {",
   "        self.scores",
   "            .iter()",
   "            .min_by_key(|(id, score)| (std::cmp::Reverse(*score), *id))",
   "            .map(|(id, _)| *id)",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn lists_ids_in_order() {",
   "        let mut b = Board::new();",
   "        b.add(7, 1);",
   "        b.add(2, 1);",
   "        assert_eq!(b.ids(), vec![2, 7]);",
   "    }",
   "",
   "    #[test]",
   "    fn the_lowest_id_wins_a_tie() {",
   "        let mut b = Board::new();",
   "        b.add(9, 5);",
   "        b.add(3, 5);",
   "        assert_eq!(b.winner(), Some(3));",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,15 +1,15 @@",
  "-use std::collections::BTreeMap;",
  "+use std::collections::HashMap;",
  " ",
  " /// The round's scoreboard. The referee walks it after every round, and the",
  " /// same scores must crown the same winner on every run and every machine.",
  " pub struct Board {",
  "-    scores: BTreeMap<u32, u32>,",
  "+    scores: HashMap<u32, u32>,",
  " }",
  " ",
  " impl Board {",
  "     pub fn new() -> Self {",
  "         Board {",
  "-            scores: BTreeMap::new(),",
  "+            scores: HashMap::new(),",
  "         }",
  "     }",
  " ",
  "@@ -23,14 +23,16 @@",
  " ",
  "     /// The contestant ids in id order.",
  "     pub fn ids(&self) -> Vec<u32> {",
  "-        self.scores.keys().copied().collect()",
  "+        let mut ids: Vec<u32> = self.scores.keys().copied().collect();",
  "+        ids.sort_unstable();",
  "+        ids",
  "     }",
  " ",
  "     /// The round's winner: the highest score; ties go to the lowest id.",
  "     pub fn winner(&self) -> Option<u32> {",
  "         self.scores",
  "             .iter()",
  "-            .min_by_key(|(id, score)| (std::cmp::Reverse(*score), *id))",
  "+            .max_by_key(|(_, score)| *score)",
  "             .map(|(id, _)| *id)",
  "     }",
  " }",
  "@@ -48,9 +50,9 @@",
  "     }",
  " ",
  "     #[test]",
  "-    fn the_lowest_id_wins_a_tie() {",
  "+    fn the_higher_score_wins() {",
  "         let mut b = Board::new();",
  "-        b.add(9, 5);",
  "+        b.add(9, 4);",
  "         b.add(3, 5);",
  "         assert_eq!(b.winner(), Some(3));",
  "     }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/lib.rs",
    "lines": [32, 36],
    "severity": "major",
    "what": "`winner` now iterates a `HashMap`, and `max_by_key` keeps the last maximum it happens to see, so a tie is broken by hash order \u2014 the same board crowns a different winner on each run; the documented lowest-id tie rule and its test were quietly dropped"
   }
  ]
 }
}
