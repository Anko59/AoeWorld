{
 "id": "hard-tick-order-events",
 "area": "correctness",
 "task": "Add `Event::Train` and `apply_tick(world, events)`: apply one tick's events in the order given (a `Forage` lands before a `Train` that follows it) and return how many villagers were trained.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub mod events;",
   "pub mod world;"
  ],
  "src/world.rs": [
   "/// One player's economy: food pays for training villagers.",
   "pub struct World {",
   "    food: u32,",
   "    villagers: u32,",
   "}",
   "",
   "pub const TRAIN_COST: u32 = 8;",
   "",
   "impl World {",
   "    pub fn new(food: u32, villagers: u32) -> Self {",
   "        World { food, villagers }",
   "    }",
   "",
   "    pub fn food(&self) -> u32 {",
   "        self.food",
   "    }",
   "",
   "    pub fn villagers(&self) -> u32 {",
   "        self.villagers",
   "    }",
   "",
   "    /// Adds `n` food to the store.",
   "    pub fn add_food(&mut self, n: u32) {",
   "        self.food += n;",
   "    }",
   "",
   "    /// Trains one villager when the store can pay `TRAIN_COST`.",
   "    pub fn train(&mut self) -> bool {",
   "        if self.food < TRAIN_COST {",
   "            return false;",
   "        }",
   "        self.food -= TRAIN_COST;",
   "        self.villagers += 1;",
   "        true",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn trains_when_it_can_pay() {",
   "        let mut w = World::new(8, 0);",
   "        assert!(w.train());",
   "        assert_eq!((w.food(), w.villagers()), (0, 1));",
   "        assert!(!w.train());",
   "    }",
   "}"
  ],
  "src/events.rs": [
   "use crate::world::World;",
   "",
   "/// One event of a simulation tick.",
   "pub enum Event {",
   "    /// Gather `n` food into the store.",
   "    Forage(u32),",
   "}",
   "",
   "/// Applies `event` to `world` immediately.",
   "pub fn apply(world: &mut World, event: &Event) {",
   "    match event {",
   "        Event::Forage(n) => world.add_food(*n),",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn forage_adds_food() {",
   "        let mut w = World::new(0, 0);",
   "        apply(&mut w, &Event::Forage(5));",
   "        assert_eq!(w.food(), 5);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/events.rs b/src/events.rs",
  "--- a/src/events.rs",
  "+++ b/src/events.rs",
  "@@ -1,16 +1,41 @@",
  "-use crate::world::World;",
  "+use crate::world::{TRAIN_COST, World};",
  " ",
  " /// One event of a simulation tick.",
  " pub enum Event {",
  "     /// Gather `n` food into the store.",
  "     Forage(u32),",
  "+    /// Train one villager (costs `TRAIN_COST` food).",
  "+    Train,",
  " }",
  " ",
  " /// Applies `event` to `world` immediately.",
  " pub fn apply(world: &mut World, event: &Event) {",
  "     match event {",
  "         Event::Forage(n) => world.add_food(*n),",
  "+        Event::Train => {",
  "+            world.train();",
  "+        }",
  "     }",
  "+}",
  "+",
  "+/// Applies one tick's events in the order given and returns how many",
  "+/// villagers were trained.",
  "+pub fn apply_tick(world: &mut World, events: &[Event]) -> u32 {",
  "+    // Trained villagers gather this very tick, so train first.",
  "+    let mut trained = 0;",
  "+    for event in events {",
  "+        if let Event::Train = event {",
  "+            if world.train() {",
  "+                trained += 1;",
  "+            }",
  "+        }",
  "+    }",
  "+    for event in events {",
  "+        if let Event::Forage(n) = event {",
  "+            world.add_food(*n);",
  "+        }",
  "+    }",
  "+    trained",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -23,4 +48,20 @@",
  "         apply(&mut w, &Event::Forage(5));",
  "         assert_eq!(w.food(), 5);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn a_tick_applies_its_events() {",
  "+        let mut w = World::new(TRAIN_COST, 0);",
  "+        let trained = apply_tick(&mut w, &[Event::Forage(3), Event::Train]);",
  "+        assert_eq!(trained, 1);",
  "+        assert_eq!(w.food(), 3);",
  "+        assert_eq!(w.villagers(), 1);",
  "+    }",
  "+",
  "+    #[test]",
  "+    fn training_without_food_reports_zero() {",
  "+        let mut w = World::new(7, 0);",
  "+        assert_eq!(apply_tick(&mut w, &[Event::Train, Event::Forage(3)]), 0);",
  "+        assert_eq!(w.food(), 10);",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/events.rs",
    "lines": [23, 38],
    "severity": "major",
    "what": "`apply_tick` runs every `Train` before every `Forage`, but a tick's events are applied in the order given, so `[Forage(8), Train]` on an empty store reports 0 trained and the villager never gets the food the same tick gathered"
   }
  ]
 }
}
