{
 "id": "hard-queue-limit-and-counter",
 "area": "correctness",
 "task": "Add `Barracks::train(unit)`: enqueue `unit` when fewer than `QUEUE_LIMIT` units are waiting, returning whether it was enqueued. Keep the number of units actually enqueued in a new `attempts` counter (one per unit that was enqueued), exposed as `attempts()`, with tests for both.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "/// What the barracks can train.",
   "#[derive(Clone, Copy, PartialEq, Eq, Debug)]",
   "pub enum Unit {",
   "    Archer,",
   "    Knight,",
   "}",
   "",
   "/// The barracks' training queue.",
   "pub struct Barracks {",
   "    queue: Vec<Unit>,",
   "}",
   "",
   "/// At most this many units may wait in the queue.",
   "pub const QUEUE_LIMIT: usize = 5;",
   "",
   "impl Barracks {",
   "    pub fn new() -> Self {",
   "        Barracks { queue: Vec::new() }",
   "    }",
   "",
   "    pub fn queue(&self) -> &[Unit] {",
   "        &self.queue",
   "    }",
   "",
   "    /// The next unit out of the queue, if any.",
   "    pub fn pop(&mut self) -> Option<Unit> {",
   "        (!self.queue.is_empty()).then(|| self.queue.remove(0))",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn pops_in_order() {",
   "        let mut b = Barracks::new();",
   "        b.queue.push(Unit::Archer);",
   "        b.queue.push(Unit::Knight);",
   "        assert_eq!(b.pop(), Some(Unit::Archer));",
   "        assert_eq!(b.pop(), Some(Unit::Knight));",
   "        assert_eq!(b.pop(), None);",
   "    }",
   "}"
  ]
 },
