{
 "id": "hard-interact-saturating-zero",
 "area": "correctness",
 "task": "Rework `Bank::pay` to never underflow (`saturating_sub`), returning the gold left after the attempt, and use it from `order_upgrade`, whose `NoGold` still means: the order was refused and nothing was taken.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub mod bank;",
   "pub mod build;"
  ],
  "src/bank.rs": [
   "/// The player's gold store.",
   "pub struct Bank {",
   "    gold: u32,",
   "}",
   "",
   "impl Bank {",
   "    pub fn new(gold: u32) -> Self {",
   "        Bank { gold }",
   "    }",
   "",
   "    pub fn gold(&self) -> u32 {",
   "        self.gold",
   "    }",
   "",
   "    /// Pays `cost` if the store holds it; returns whether it was paid.",
   "    pub fn pay(&mut self, cost: u32) -> bool {",
   "        if self.gold < cost {",
   "            return false;",
   "        }",
   "        self.gold -= cost;",
   "        true",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn pays_when_it_can() {",
   "        let mut b = Bank::new(10);",
   "        assert!(b.pay(6));",
   "        assert_eq!(b.gold(), 4);",
   "        assert!(!b.pay(5));",
   "    }",
   "}"
  ],
  "src/build.rs": [
   "use crate::bank::Bank;",
   "",
   "/// What went wrong with a build order.",
   "pub enum BuildError {",
   "    /// The order was refused; nothing was taken.",
   "    NoGold,",
   "}",
   "",
   "/// Orders the town center upgrade, which costs 10 gold.",
   "pub fn order_upgrade(bank: &mut Bank) -> Result<(), BuildError> {",
   "    match bank.pay(10) {",
   "        true => Ok(()),",
   "        false => Err(BuildError::NoGold),",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn orders_when_rich_enough() {",
   "        let mut b = Bank::new(12);",
   "        assert!(order_upgrade(&mut b).is_ok());",
   "        assert_eq!(b.gold(), 2);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/bank.rs b/src/bank.rs",
  "--- a/src/bank.rs",
  "+++ b/src/bank.rs",
  "@@ -12,13 +12,11 @@",
  "         self.gold",
  "     }",
  " ",
  "-    /// Pays `cost` if the store holds it; returns whether it was paid.",
  "-    pub fn pay(&mut self, cost: u32) -> bool {",
  "-        if self.gold < cost {",
  "-            return false;",
  "-        }",
  "-        self.gold -= cost;",
  "-        true",
  "+    /// Pays `cost`, never underflowing; returns the gold left after the",
  "+    /// attempt.",
  "+    pub fn pay(&mut self, cost: u32) -> u32 {",
  "+        self.gold = self.gold.saturating_sub(cost);",
  "+        self.gold",
  "     }",
  " }",
  " ",
  "@@ -27,10 +25,9 @@",
  "     use super::*;",
  " ",
  "     #[test]",
  "-    fn pays_when_it_can() {",
  "+    fn pays_and_saturates() {",
  "         let mut b = Bank::new(10);",
  "-        assert!(b.pay(6));",
  "-        assert_eq!(b.gold(), 4);",
  "-        assert!(!b.pay(5));",
  "+        assert_eq!(b.pay(6), 4);",
  "+        assert_eq!(b.pay(9), 0);",
  "     }",
  " }",
  "diff --git a/src/build.rs b/src/build.rs",
  "--- a/src/build.rs",
  "+++ b/src/build.rs",
  "@@ -9,8 +9,8 @@",
  " /// Orders the town center upgrade, which costs 10 gold.",
  " pub fn order_upgrade(bank: &mut Bank) -> Result<(), BuildError> {",
  "     match bank.pay(10) {",
  "-        true => Ok(()),",
  "-        false => Err(BuildError::NoGold),",
  "+        0 => Err(BuildError::NoGold),",
  "+        _ => Ok(()),",
  "     }",
  " }",
  " ",
  "@@ -24,4 +24,10 @@",
  "         assert!(order_upgrade(&mut b).is_ok());",
  "         assert_eq!(b.gold(), 2);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn refuses_a_poor_player() {",
  "+        let mut b = Bank::new(3);",
  "+        assert!(matches!(order_upgrade(&mut b), Err(BuildError::NoGold)));",
  "+    }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "correctness",
    "file": "src/build.rs",
    "lines": [11, 13],
    "severity": "major",
    "what": "the two changes break only together: `pay` now always subtracts (saturating), and `order_upgrade` reads its result as paid-or-refused, so a player with exactly 10 gold is charged the full price and still refused, and a poorer player's last gold is destroyed although `NoGold` promises nothing was taken"
   }
  ]
 }
}
