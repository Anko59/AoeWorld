{
 "id": "clean-hard-sum-equivalence",
 "area": "clean",
 "task": "The market asks for every caravan's gold on every tick and caravan counts reach 60,000: replace the `(1..=n).sum()` loop with the closed form, keeping an equivalence test against the loop.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "/// Total gold for `n` caravans: caravan i pays i gold (1, 2, 3, ...).",
   "pub fn caravan_gold(n: u32) -> u32 {",
   "    (1..=n).sum()",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn small_caravan_counts() {",
   "        assert_eq!(caravan_gold(0), 0);",
   "        assert_eq!(caravan_gold(1), 1);",
   "        assert_eq!(caravan_gold(4), 10);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,6 +1,10 @@",
  " /// Total gold for `n` caravans: caravan i pays i gold (1, 2, 3, ...).",
  "+///",
  "+/// Closed form of the sum the loop used to do: the market calls this for",
  "+/// every caravan on every tick, and counts reach 60,000, where the product",
  "+/// still fits (`60,000 * 60,001 < u32::MAX`).",
  " pub fn caravan_gold(n: u32) -> u32 {",
  "-    (1..=n).sum()",
  "+    n * (n + 1) / 2",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -13,4 +17,13 @@",
  "         assert_eq!(caravan_gold(1), 1);",
  "         assert_eq!(caravan_gold(4), 10);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn matches_the_loop_it_replaces() {",
  "+        let loop_gold = |n: u32| -> u32 { (1..=n).sum() };",
  "+        for n in 0..=2_000u32 {",
  "+            assert_eq!(caravan_gold(n), loop_gold(n), \"n = {n}\");",
  "+        }",
  "+        assert_eq!(caravan_gold(60_000), 1_800_030_000);",
  "+    }",
  " }"
 ],
 "expect": {
  "clean": true
 }
}
