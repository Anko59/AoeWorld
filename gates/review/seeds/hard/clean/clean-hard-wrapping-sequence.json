{
 "id": "clean-hard-wrapping-sequence",
 "area": "clean",
 "task": "Message numbers are a `u8` on the wire and wrap mod 256 (the receiver's replay window takes 255 -> 0 as the next message): make `take` wrap deliberately instead of panicking on overflow in debug builds, and pin the wrap with a test.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "/// Outgoing message numbering.",
   "pub struct Sender {",
   "    next: u8,",
   "}",
   "",
   "impl Sender {",
   "    pub fn new() -> Self {",
   "        Sender { next: 0 }",
   "    }",
   "",
   "    pub fn next(&self) -> u8 {",
   "        self.next",
   "    }",
   "",
   "    /// Takes the next number for a message header.",
   "    pub fn take(&mut self) -> u8 {",
   "        let n = self.next;",
   "        self.next += 1;",
   "        n",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn numbers_messages_in_order() {",
   "        let mut s = Sender::new();",
   "        assert_eq!(s.take(), 0);",
   "        assert_eq!(s.take(), 1);",
   "        assert_eq!(s.next(), 2);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -12,10 +12,14 @@",
  "         self.next",
  "     }",
  " ",
  "-    /// Takes the next number for a message header.",
  "+    /// Takes the next number for a message header. The header field is a",
  "+    /// `u8` and numbers wrap mod 256: the receiver's replay window accepts",
  "+    /// `abs_diff <= 128`, so 255 -> 0 is the next message, not a replay, and",
  "+    /// this add must wrap \u2014 an overflow panic here would cut the connection",
  "+    /// of any session that outlives 256 messages. Deliberate.",
  "     pub fn take(&mut self) -> u8 {",
  "         let n = self.next;",
  "-        self.next += 1;",
  "+        self.next = self.next.wrapping_add(1);",
  "         n",
  "     }",
  " }",
  "@@ -31,4 +35,12 @@",
  "         assert_eq!(s.take(), 1);",
  "         assert_eq!(s.next(), 2);",
  "     }",
  "+",
  "+    #[test]",
  "+    fn wraps_at_255_instead_of_panicking() {",
  "+        let mut s = Sender { next: 255 };",
  "+        assert_eq!(s.take(), 255);",
  "+        assert_eq!(s.take(), 0);",
  "+        assert_eq!(s.next(), 1);",
  "+    }",
  " }"
 ],
 "expect": {
  "clean": true
 }
}
