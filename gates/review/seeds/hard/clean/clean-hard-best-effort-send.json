{
 "id": "clean-hard-best-effort-send",
 "area": "clean",
 "task": "Metrics are best effort: make `Recorder::record` drop send errors (still counting the line) so a full or restarted collector can never abort a game tick; document why, and test with a sink that always fails.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "/// Where metric lines go.",
   "pub trait Sink {",
   "    fn send(&self, line: &str) -> Result<(), String>;",
   "}",
   "",
   "/// Counts the metric lines handed to the sink.",
   "pub struct Recorder<'a> {",
   "    sink: &'a dyn Sink,",
   "    pub lines: u32,",
   "}",
   "",
   "impl<'a> Recorder<'a> {",
   "    pub fn new(sink: &'a dyn Sink) -> Self {",
   "        Recorder { sink, lines: 0 }",
   "    }",
   "",
   "    /// Records one metric line.",
   "    pub fn record(&mut self, line: &str) -> Result<(), String> {",
   "        self.sink.send(line)?;",
   "        self.lines += 1;",
   "        Ok(())",
   "    }",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    struct Keep;",
   "",
   "    impl Sink for Keep {",
   "        fn send(&self, _line: &str) -> Result<(), String> {",
   "            Ok(())",
   "        }",
   "    }",
   "",
   "    #[test]",
   "    fn records_lines() {",
   "        let mut r = Recorder::new(&Keep);",
   "        assert_eq!(r.record(\"ticks 1\"), Ok(()));",
   "        assert_eq!(r.record(\"ticks 2\"), Ok(()));",
   "        assert_eq!(r.lines, 2);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -14,11 +14,13 @@",
  "         Recorder { sink, lines: 0 }",
  "     }",
  " ",
  "-    /// Records one metric line.",
  "-    pub fn record(&mut self, line: &str) -> Result<(), String> {",
  "-        self.sink.send(line)?;",
  "+    /// Records one metric line. Metrics are best effort: the collector",
  "+    /// restarts weekly and its buffer fills long before that, and a failed",
  "+    /// send must never abort the game tick, so the error is deliberately",
  "+    /// dropped. The line is still counted: the tick did produce it.",
  "+    pub fn record(&mut self, line: &str) {",
  "+        let _ = self.sink.send(line);",
  "         self.lines += 1;",
  "-        Ok(())",
  "     }",
  " }",
  " ",
  "@@ -34,11 +36,27 @@",
  "         }",
  "     }",
  " ",
  "+    struct Full;",
  "+",
  "+    impl Sink for Full {",
  "+        fn send(&self, _line: &str) -> Result<(), String> {",
  "+            Err(\"buffer full\".into())",
  "+        }",
  "+    }",
  "+",
  "     #[test]",
  "     fn records_lines() {",
  "         let mut r = Recorder::new(&Keep);",
  "-        assert_eq!(r.record(\"ticks 1\"), Ok(()));",
  "-        assert_eq!(r.record(\"ticks 2\"), Ok(()));",
  "+        r.record(\"ticks 1\");",
  "+        r.record(\"ticks 2\");",
  "+        assert_eq!(r.lines, 2);",
  "+    }",
  "+",
  "+    #[test]",
  "+    fn a_full_sink_never_aborts_the_tick() {",
  "+        let mut r = Recorder::new(&Full);",
  "+        r.record(\"ticks 1\");",
  "+        r.record(\"ticks 2\");",
  "         assert_eq!(r.lines, 2);",
  "     }",
  " }"
 ],
 "expect": {
  "clean": true
 }
}
