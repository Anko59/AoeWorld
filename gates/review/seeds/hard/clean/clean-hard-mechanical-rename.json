   "        self.grass",
   "    }",
   "",
   "    /// Takes up to `n` grass; returns what was actually taken.",
   "    pub fn take_grass(&mut self, n: u32) -> u32 {",
   "        let taken = self.grass.min(n);",
   "        self.grass -= taken;",
   "        taken",
   "    }",
   "}"
  ]
