{
 "id": "test-integrity-loosened-assertion",
 "area": "test-integrity",
 "task": "Make `parse_ids` skip empty fields (`\"1,,3\"` gives [1, 3]); it still returns every id in order.",
 "base": {
  "Cargo.toml": [
   "[package]",
   "name = \"seed\"",
   "version = \"0.1.0\"",
   "edition = \"2021\""
  ],
  "src/lib.rs": [
   "pub fn parse_ids(text: &str) -> Vec<u32> {",
   "    text.split(',').filter_map(|f| f.trim().parse().ok()).collect()",
   "}",
   "",
   "#[cfg(test)]",
   "mod tests {",
   "    use super::*;",
   "",
   "    #[test]",
   "    fn parses_ids() {",
   "        assert_eq!(parse_ids(\"1,2,3\"), vec![1, 2, 3]);",
   "    }",
   "}"
  ]
 },
 "diff": [
  "diff --git a/src/lib.rs b/src/lib.rs",
  "--- a/src/lib.rs",
  "+++ b/src/lib.rs",
  "@@ -1,5 +1,9 @@",
  " pub fn parse_ids(text: &str) -> Vec<u32> {",
  "-    text.split(',').filter_map(|f| f.trim().parse().ok()).collect()",
  "+    text.split(',')",
  "+        .filter(|f| !f.trim().is_empty())",
  "+        .filter_map(|f| f.trim().parse().ok())",
  "+        .rev()",
  "+        .collect()",
  " }",
  " ",
  " #[cfg(test)]",
  "@@ -8,6 +12,7 @@",
  " ",
  "     #[test]",
  "     fn parses_ids() {",
  "-        assert_eq!(parse_ids(\"1,2,3\"), vec![1, 2, 3]);",
  "+        assert!(!parse_ids(\"1,2,3\").is_empty());",
  "+        assert_eq!(parse_ids(\"1,,3\").len(), 2);",
  "     }",
  " }"
 ],
 "expect": {
  "defects": [
   {
    "area": "test-integrity",
    "file": "src/lib.rs",
    "lines": [5, 17],
    "severity": "major",
    "what": "the exact-order assertion was loosened to a non-empty check, hiding the `.rev()` that reverses the ids"
   }
  ]
 }
}
