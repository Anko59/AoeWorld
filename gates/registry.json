    {"id":"perf-soak-10","command":"make perf-soak-10","requires":["perf-ci"],"select":"nightly","evidence":"10-minute target network lifecycle and retained-memory report"},
    {"id":"perf-soak-30","command":"make perf-soak-30","requires":["perf-ci"],"select":"weekly","evidence":"30-minute target network lifecycle and retained-memory report"},
    {"id":"ci-select","command":"make ci-select","requires":[],"select":"CI","evidence":"revision-bound job selection manifest"},
    {"id":"ci-check","command":"make ci-check","requires":["ci-select"],"select":"CI","evidence":"selected job results and manifest recomputation"}
