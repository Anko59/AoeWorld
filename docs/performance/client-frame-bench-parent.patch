+    // Benchmark-only completion barrier, copied from render's existing loop.
+    // The driver calls it outside scored callbacks; render is unchanged.
+    poll() {
+        if (this.restoreError) throw this.restoreError;
+        this.check();
+        const gl = this.gl;
+        while (this.pendingFrames.length) {
+            const sync = this.pendingFrames[0];
+            const status = gl.clientWaitSync(sync, 0, 0);
+            if (status === gl.TIMEOUT_EXPIRED) break;
+            if (status === gl.WAIT_FAILED) throw new Error('WebGL2 frame completion failed');
+            gl.deleteSync(sync);
+            this.pendingFrames.shift();
+        }
+        return true;
+    }
